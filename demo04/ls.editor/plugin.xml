<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>

<!--
-->

<plugin>

   <extension point="org.eclipse.ui.newWizards">
      <!-- @generated ls -->
      <category
            id="org.eclipse.emf.ecore.Wizard.category.ID"
            name="%_UI_Wizard_category"/>
      <wizard
            id="ls.presentation.LsModelWizardID"
            name="%_UI_LsModelWizard_label"
            class="ls.presentation.LsModelWizard"
            category="org.eclipse.emf.ecore.Wizard.category.ID"
            icon="icons/full/obj16/LsModelFile.gif">
         <description>%_UI_LsModelWizard_description</description>
         <selection class="org.eclipse.core.resources.IResource"/>
      </wizard>
   </extension>

   <extension point="org.eclipse.ui.editors">
      <!-- @generated ls -->
      <editor
            id="ls.presentation.LsEditorID"
            name="%_UI_LsEditor_label"
            icon="icons/full/obj16/LsModelFile.gif"
            extensions="ls"
            class="ls.presentation.LsEditor"
            contributorClass="ls.presentation.LsActionBarContributor">
      </editor>
   </extension>

</plugin>
