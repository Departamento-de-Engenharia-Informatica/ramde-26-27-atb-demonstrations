<?xml version='1.0' encoding='UTF-8'?>
<!-- Schema file written by PDE -->
<schema targetNamespace="org.eclipse.dsl.diagram.ui" xmlns="http://www.w3.org/2001/XMLSchema">
<annotation>
      <appinfo>
         <meta.schema plugin="org.eclipse.dsl.diagram.ui" id="diagramProviders" name="DSL Diagram Provider"/>
      </appinfo>
      <documentation>
         Extension point allowing Xtext DSL plugins to register custom PlantUML diagram converters and navigation providers.
      </documentation>
   </annotation>

   <element name="extension">
      <annotation>
         <appinfo>
            <meta.element />
         </appinfo>
      </annotation>
      <complexType>
         <sequence minOccurs="1" maxOccurs="unbounded">
            <element ref="provider"/>
         </sequence>
         <attribute name="point" type="string" use="required" />
         <attribute name="id" type="string" />
         <attribute name="name" type="string" />
      </complexType>
   </element>

   <element name="provider">
      <annotation>
         <documentation>
            Specifies a diagram provider implementation for a specific DSL metamodel.
         </documentation>
      </annotation>
      <complexType>
         <attribute name="class" type="string" use="required">
            <annotation>
               <documentation>
                  Fully qualified name of the Java class implementing IDslDiagramProvider.
               </documentation>
               <appinfo>
                  <meta.attribute kind="java" basedOn=":org.eclipse.dsl.diagram.ui.api.IDslDiagramProvider"/>
               </appinfo>
            </annotation>
         </attribute>
      </complexType>
   </element>

</schema>