<?xml version="1.0" encoding="UTF-8"?>
<genmodel:GenModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:genmodel="http://www.eclipse.org/emf/2002/GenModel"
    modelDirectory="/ls/src-gen" creationIcons="false" editDirectory="/ls.edit/src-gen"
    editorDirectory="/ls.editor/src-gen" modelPluginID="ls" modelName="Ls" rootExtendsClass="org.eclipse.emf.ecore.impl.MinimalEObjectImpl$Container"
    codeFormatting="true" importerID="org.eclipse.emf.importer.ecore" complianceLevel="21.0"
    copyrightFields="false" operationReflection="true" importOrganizing="true">
  <foreignModel>ls.ecore</foreignModel>
  <testsDirectory xsi:nil="true"/>
  <genPackages prefix="Ls" disposableProviderFactory="true" ecorePackage="ls.ecore#/">
    <genClasses ecoreClass="ls.ecore#//LSModel">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute ls.ecore#//LSModel/name"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference ls.ecore#//LSModel/rooms"/>
    </genClasses>
    <genClasses ecoreClass="ls.ecore#//Light">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute ls.ecore#//Light/lumens"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute ls.ecore#//Light/dimLevel"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute ls.ecore#//Light/name"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute ls.ecore#//Light/currentLumens"/>
      <genOperations ecoreOperation="ls.ecore#//Light/turnOff"/>
      <genOperations ecoreOperation="ls.ecore#//Light/turnOnLevel">
        <genParameters ecoreParameter="ls.ecore#//Light/turnOnLevel/level"/>
      </genOperations>
    </genClasses>
    <genClasses ecoreClass="ls.ecore#//LightSwitch">
      <genFeatures notify="false" createChild="false" propertySortChoices="true" ecoreFeature="ecore:EReference ls.ecore#//LightSwitch/lights"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute ls.ecore#//LightSwitch/name"/>
      <genOperations ecoreOperation="ls.ecore#//LightSwitch/buttonOn"/>
      <genOperations ecoreOperation="ls.ecore#//LightSwitch/buttonOff"/>
    </genClasses>
    <genClasses ecoreClass="ls.ecore#//Room">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute ls.ecore#//Room/name"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute ls.ecore#//Room/area"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute ls.ecore#//Room/max_lux"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute ls.ecore#//Room/min_lux"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference ls.ecore#//Room/lights"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference ls.ecore#//Room/batterypoweredsecuritylights"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference ls.ecore#//Room/lightswitchs"/>
    </genClasses>
    <genClasses ecoreClass="ls.ecore#//BatteryPoweredSecurityLight">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute ls.ecore#//BatteryPoweredSecurityLight/name"/>
    </genClasses>
  </genPackages>
</genmodel:GenModel>
