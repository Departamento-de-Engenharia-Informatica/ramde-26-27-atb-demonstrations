def compileRoom(Room room) '''
		package generated;

		import java.util.ArrayList;
		import java.util.List;
		import java.util.Scanner;

		public class «room.name.toFirstUpper» implements RoomInterface {
		    private String name;
		    private float area;
		    private float maxLux;
		    private float minLux;
		    
		    private List<Light> lights = new ArrayList<>();
		    private List<LightSwitchInterface> switches = new ArrayList<>();

		    public «room.name.toFirstUpper»(String name, float area, float maxLux, float minLux) {
		        this.name = name;
		        this.area = area;
		        this.maxLux = maxLux;
		        this.minLux = minLux;
		    }

		    public void addLight(Light light) { this.lights.add(light); }
		    public void addSwitch(LightSwitchInterface sw) { this.switches.add(sw); }

		    @Override
		    public String getName() { return name; }

		    @Override
		    public float getMaxLux() { return maxLux; }

		    @Override
		    public float getTotalLumens() {
		        float sum = 0.0f;
		        for (Light l : lights) {
		            sum += l.getCurrentLumens();
		        }
		        return sum;
		    }

		    @Override
		    public void printStatus() {
		        System.out.println("LIGHTS:");
		        for (Light l : lights) {
		            System.out.println("  - " + l.getName() + " | State: " + (l.getDimLevel() > 0 ? "ON (" + (l.getDimLevel() * 100) + "%)" : "OFF") + " | Current Output: " + l.getCurrentLumens() + " lumens");
		        }
		        System.out.println("SWITCHES:");
		        for (int i = 0; i < switches.size(); i++) {
		            LightSwitchInterface sw = switches.get(i);
		            System.out.println("  [" + (i + 1) + "] " + sw.getName() + " (FSM State: " + sw.getCurrentFSMState() + ")");
		        }
		    }

		    @Override
		    public void interactWithSwitches(Scanner scanner) {
		        if (switches.isEmpty()) {
		            System.out.println("No switches in this room.");
		            return;
		        }
		        
		        System.out.print("Select switch number (1-" + switches.size() + "): ");
		        try {
		            int idx = Integer.parseInt(scanner.nextLine().trim()) - 1;
		            if (idx >= 0 && idx < switches.size()) {
		                LightSwitchInterface sw = switches.get(idx);
		                
		                System.out.println("\n--- Select action for switch '" + sw.getName() + "' ---");
		                System.out.println("1. Press buttonOn()");
		                System.out.println("2. Press buttonOff()");
		                System.out.print("Select option: ");
		                
		                int btnChoice = Integer.parseInt(scanner.nextLine().trim());
		                if (btnChoice == 1) {
		                    sw.pressButtonOn();
		                } else if (btnChoice == 2) {
		                    sw.pressButtonOff();
		                } else {
		                    System.out.println("Invalid button selection.");
		                }
		            } else {
		                System.out.println("Invalid switch number.");
		            }
		        } catch (Exception e) {
		            System.out.println("Invalid input.");
		        }
		    }

		    @Override
		    public String toString() {
		        return name + " (" + lights.size() + " lights, " + switches.size() + " switches)";
		    }
		}
	'''

