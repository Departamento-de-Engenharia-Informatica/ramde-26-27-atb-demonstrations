def compileFSMController(FSMModel fsm) '''
    package generated;

    public class «fsm.name.toFirstUpper»Controller implements FSMControllerInterface {
        private String currentStateName = "«fsm.initialState.name»";
        private «fsm.appliesTo.name.toFirstUpper» targetSwitch;

        public «fsm.name.toFirstUpper»Controller(«fsm.appliesTo.name.toFirstUpper» targetSwitch) {
            this.targetSwitch = targetSwitch;
            
            // Enforce initial state execution on startup
            executeStateAction("«fsm.initialState.outputOperationName»", 
                «IF fsm.initialState.operationParameterValue !== null»«fsm.initialState.operationParameterValue»f«ELSE»null«ENDIF»);
        }

        @Override
        public String getCurrentState() {
            return currentStateName;
        }

    	@Override
          public void fireEvent(String eventName) {
                switch (currentStateName) {
                    «FOR state : fsm.state»
                    case "«state.name»":
                        «FOR tr : fsm.transition.filter[t | t.sourceState == state]»
                        if ("«tr.event.name»".equalsIgnoreCase(eventName) || "«tr.event.operationName»".equalsIgnoreCase(eventName)) {
                            transitionTo("«tr.targetState.name»", 
                                "«tr.targetState.outputOperationName»", 
                                «IF tr.targetState.operationParameterValue !== null»"«tr.targetState.operationParameterValue»"«ELSE»""«ENDIF»);
                            return;
                        }
                        «ENDFOR»
                        System.out.println("[FSM Warning] No transition defined from state '" + currentStateName + "' for event '" + eventName + "'");
                        break;
                    «ENDFOR»
                    default:
                        System.out.println("[FSM Error] Unknown state: " + currentStateName);
                        break;
                }
            } 

        private void transitionTo(String nextState, String outputOperation, String paramValue) {
            System.out.println("[FSM Transition] " + currentStateName + " ---> " + nextState);
            this.currentStateName = nextState;
            executeStateAction(outputOperation, paramValue);
        }

        private void executeStateAction(String operationName, String paramValue) {
            if (operationName == null || operationName.isEmpty()) return;

            // Loop over all target lights associated with the switch
            for (Light light : targetSwitch.getConnectedLights()) {
                executeOnLight(light, operationName, paramValue);
            }
        }

        private void executeOnLight(Light light, String operationName, String paramValue) {
            switch (operationName) {
                case "turnOff":
                    light.turnOff();
                    break;
                case "turnOnLevel":
                	try {
                		Float level=1.0f;
                		
                		if (paramValue == null)
                			level=1.0f;
                		else {
                			level=Float.parseFloat(paramValue);	
                		}	
                		light.turnOnLevel(level);
                	} catch (Exception e) {
                	    System.err.println("Could not convert the operation parm '" + paramValue + "' on operation " + operationName);
                	}
                    break;
                default:
                    // Reflection fallback for extra flexibility
                    try {
                        if (paramValue != null) {
                            var method = light.getClass().getMethod(operationName, float.class);
                            method.invoke(light, paramValue);
                        } else {
                            var method = light.getClass().getMethod(operationName);
                            method.invoke(light);
                        }
                    } catch (Exception e) {
                        System.err.println("Could not execute operation '" + operationName + "' on light " + light.getName());
                    }
                    break;
            }
        }
    }
