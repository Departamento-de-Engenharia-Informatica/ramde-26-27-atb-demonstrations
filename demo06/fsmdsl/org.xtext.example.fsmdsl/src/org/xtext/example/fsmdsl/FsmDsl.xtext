// automatically generated by Xtext
grammar org.xtext.example.fsmdsl.FsmDsl with org.eclipse.xtext.common.Terminals

import "http://www.example.org/fsm" 
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
import "http://www.example.org/ls" as ls

FSMModel returns FSMModel:
	'FSMModel'
	name=EString
	'{'
		('appliesTo' appliesTo=[ls::LightSwitch|EString])?
		('state' '{' state+=State ( "," state+=State)* '}' )?
		'initialState' initialState=[State|EString]
		('event' '{' event+=Event ( "," event+=Event)* '}' )?
		('transition' '{' transition+=Transition ( "," transition+=Transition)* '}' )?
	'}'; 

EString returns ecore::EString:
	STRING | ID;

State returns State:
	'State'
	name=EString
	'{'
		('appliesTo' appliesTo=[ls::Light|EString])?	
		'outputOperationName' outputOperationName=EString
		( '(' 'operationParameterValue' operationParameterValue=EString ')' )?
	'}';
	
Transition returns Transition:
	'Transition'
	name=EString
	'{'
		'sourceState' sourceState=[State|EString]
		'targetState' targetState=[State|EString]
		'event' event=[Event|EString]
	'}';

Event returns Event:
	{Event}
	'Event'
	name=EString
	'{'
		('operationName' operationName=EString)?
	'}';
	